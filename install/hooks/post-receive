#!/bin/bash

set -euo pipefail

WORK_TREE="/srv/deploy/dummy_repo_1"
GIT_DIR="/srv/git/dummy_repo_1.git"
LOG="/tmp/deploy.log"

mkdir -p "$WORK_TREE"

while read oldrev newrev refname
do
    echo "Log:" >> "$LOG"
    echo "Push received: $(date)" >> "$LOG"
    echo "Ref : $refname" >> "$LOG"
    echo "Old : $oldrev" >> "$LOG"
    echo "New : $newrev" >> "$LOG"

    git --work-tree="$WORK_TREE" \
        --git-dir="$GIT_DIR" \
        checkout -f "$newrev" >> "$LOG" 2>&1

    CHANGED_FILES=$(git --git-dir="$GIT_DIR" diff --name-only "$oldrev" "$newrev")

    echo "Changed files:" >> "$LOG"
    echo "$CHANGED_FILES" >> "$LOG"

    HEX_FILES=$(echo "$CHANGED_FILES" | grep -E '^firmware/.*\.hex$' || true)

    if [ -n "$HEX_FILES" ]; then
        echo "Firmware HEX changed." >> "$LOG"

        HEX_FILE="$WORK_TREE/$(echo "$HEX_FILES" | head -n 1)"

        if [ ! -f "$HEX_FILE" ]; then
            echo "ERROR: HEX file not found: $HEX_FILE" >> "$LOG"
            exit 1
        fi

        echo "HEX file found: $HEX_FILE" >> "$LOG"
        echo "Flashing onto the Teensy..." >> "$LOG"
        
        ls /dev/ | grep 'teensy' 2&> "$LOG"
        if [[ "$?" -ne 0 ]]; then
           echo "ERROR: Teensy not detected! Review above log for further info.\n" >> "$LOG"
     	   exit 1
        fi

        /usr/local/bin/teensy_loader_cli \
            --mcu=TEENSY41 \
            -w \
            -v \
            "$HEX_FILE" \
            >> "$LOG" 2>&1

        echo "Flash successful." >> "$LOG"
    else
        echo "No firmware HEX changes detected. Skipping deployment." >> "$LOG"
    fi

done

echo "Deployment hook finished." >> "$LOG"
